# ===========================================
# HLA-ProtBERT .gitignore
# ===========================================

# ---------- Python ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# ---------- Virtual Environments ----------
.env
.venv
env/
venv/
ENV/
env.bak/
venv.bak/
.python-version

# ---------- Distribution / Packaging ----------
build/
dist/
develop-eggs/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---------- Jupyter Notebooks ----------
.ipynb_checkpoints/
*.ipynb  # Exclude notebooks from package (keep in repo for development)

# ---------- Testing ----------
.coverage
.coverage.*
coverage.xml
htmlcov/
.tox/
.nox/
.hypothesis/
.pytest_cache/
*.cover

# ---------- IDE / Editor ----------
.idea/
.vscode/
*.swp
*.swo
*.sublime-workspace
*.sublime-project

# ---------- OS Specific ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# ---------- Logs ----------
logs/
*.log

# ---------- Project Data (User-Generated) ----------
# Users download their own data - don't include in repo
data/raw/*
data/processed/*
data/embeddings/*
data/analysis/*

# Keep directory structure with .gitkeep files
!data/raw/.gitkeep
!data/processed/.gitkeep
!data/embeddings/.gitkeep
!data/analysis/.gitkeep

# ---------- Generated Reports / Outputs ----------
*.pdf
matching_report.*
*.csv

# ---------- Presentations (Internal) ----------
presentations/

# ---------- Notebooks (Large Output Files) ----------
notebooks/

# ---------- Benchmarks (Internal Development) ----------
benchmarks/

# ---------- Model Cache / Downloads ----------
models/
*.pt
*.pth
*.bin
*.safetensors

# ---------- AI Assistant Config ----------
.claude/
.cursor/
.github/
CLAUDE.md

# ---------- R Session ----------
.Rhistory
.RData
.Rproj.user/

# ---------- Misc ----------
*.bak
*.tmp
*.temp
.cache/